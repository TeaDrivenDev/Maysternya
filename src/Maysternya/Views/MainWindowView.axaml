<Window
    Design.DataContext="{Binding Source={x:Static vm:MainWindowViewModel.DesignVM}}"
    Icon="/Assets/avalonia-logo.ico"
    Title="Maysternya"
    Width="1200"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="TeaDriven.Maysternya.Views.MainWindowView"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:TeaDriven.Maysternya.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uiUtilities="using:TeaDriven.Maysternya.UIUtilities"
    xmlns:vm="using:TeaDriven.Maysternya.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Styles>
        <Style Selector="TextBox.Invalid">
            <Setter Property="Background" Value="DarkRed" />
        </Style>
        <Style Selector="TextBox.Valid">
            <Setter Property="Background" Value="DarkGreen" />
        </Style>

        <Style Selector="Button.SelectFile">
            <Setter Property="Content" Value="…" />
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="3 0 0 0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="DataGridRow DataGridCell">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid Margin="5">
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid
                ColumnDefinitions="*,Auto"
                Grid.Row="0"
                Margin="0,0,0,5">
                <TextBox
                    Classes.Invalid="{Binding !IsSteamDirectoryValid}"
                    Classes.Valid="{Binding IsSteamDirectoryValid}"
                    Grid.Column="0"
                    Text="{Binding SteamDirectory}"
                    Watermark="Steam Directory" />
                <Button
                    Classes="SelectFile"
                    Command="{Binding SelectSteamDirectory}"
                    Grid.Column="1" />
            </Grid>

            <Grid
                ColumnDefinitions="*,*"
                Grid.Row="1"
                Margin="2,5,2,0">
                <TextBlock
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    IsVisible="{Binding IsShowWorkshopDirectoryMessage}"
                    Text="{Binding WorkshopDirectoryMessage}" />

                <RadioButton
                    Content="{Binding Ets2ModsDirectoryMessage}"
                    Grid.Column="0"
                    GroupName="SelectedGame"
                    IsCheckedChanged="SelectedGame_OnIsCheckedChanged"
                    IsEnabled="{Binding IsEts2ModsDirectoryFound}"
                    IsVisible="{Binding !IsShowWorkshopDirectoryMessage}"
                    Margin="0,0,2,0"
                    Tag="{x:Static domain:SelectedGame.Ets2}">
                    <RadioButton.IsChecked>
                        <MultiBinding Converter="{x:Static uiUtilities:ValuesEqualMultiConverter.Instance}">
                            <Binding Path="SelectedGame" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </RadioButton.IsChecked>
                </RadioButton>

                <RadioButton
                    Content="{Binding AtsModsDirectoryMessage}"
                    Grid.Column="1"
                    GroupName="SelectedGame"
                    IsCheckedChanged="SelectedGame_OnIsCheckedChanged"
                    IsEnabled="{Binding IsAtsModsDirectoryFound}"
                    IsVisible="{Binding !IsShowWorkshopDirectoryMessage}"
                    Margin="2,0,0,0"
                    Tag="{x:Static domain:SelectedGame.Ats}">
                    <RadioButton.IsChecked>
                        <MultiBinding Converter="{x:Static uiUtilities:ValuesEqualMultiConverter.Instance}">
                            <Binding Path="SelectedGame" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </RadioButton.IsChecked>
                </RadioButton>
            </Grid>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <DataGrid ItemsSource="{Binding Mods}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding Id}"
                            Header="ID"
                            Width="100" />

                        <DataGridTemplateColumn
                            CanUserResize="True"
                            CanUserSort="True"
                            Header="Name"
                            SortMemberPath="Name"
                            Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip.Tip="{Binding Description}">
                                        <TextBlock
                                            Classes.DescriptionDisplayName="{Binding DisplayNameSource, Converter={x:Static uiUtilities:ValueEqualsParameterConverter.Instance}, ConverterParameter={x:Static domain:DisplayNameSource.DescriptionFile}}"
                                            Classes.UnavailableDisplayName="{Binding DisplayNameSource, Converter={x:Static uiUtilities:ValueEqualsParameterConverter.Instance}, ConverterParameter={x:Static domain:DisplayNameSource.Unavailable}}"
                                            VerticalAlignment="Center">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Name}" />
                                                </Style>

                                                <Style Selector="TextBlock.DescriptionDisplayName">
                                                    <Setter Property="Text" Value="{Binding Name, StringFormat=> {0}}" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                    <Setter Property="Foreground" Value="LightGray" />
                                                </Style>

                                                <Style Selector="TextBlock.UnavailableDisplayName">
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                    <Setter Property="Foreground" Value="LightSlateGray" />
                                                </Style>
                                            </TextBlock.Styles>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            CanUserResize="True"
                            CanUserSort="True"
                            Header="Author"
                            SortMemberPath="Author"
                            Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip.Tip="{Binding Author}">
                                        <TextBlock Text="{Binding Author}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Binding="{Binding Version}"
                            CanUserSort="False"
                            Header="Version"
                            Width="100" />

                        <DataGridTemplateColumn Header="Compatible" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding HighestCompatibleGameVersion}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Content="X"
                                            Grid.Column="1"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
