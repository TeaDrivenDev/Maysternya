<Window x:Class="TeaDriven.Maysternya.Views.MainWindowView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:domain="using:TeaDriven.Maysternya.Domain"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uiUtilities="using:TeaDriven.Maysternya.UIUtilities"
        xmlns:vm="using:TeaDriven.Maysternya.ViewModels"
        Title="Maysternya"
        Width="1200"
        d:DesignHeight="450"
        d:DesignWidth="800"
        x:DataType="vm:MainWindowViewModel"
        Design.DataContext="{Binding Source={x:Static vm:MainWindowViewModel.DesignVM}}"
        Icon="/Assets/avalonia-logo.ico"
        mc:Ignorable="d">
    <Window.Styles>
        <Style Selector="TextBox.Invalid">
            <Setter Property="Background" Value="DarkRed" />
        </Style>
        <Style Selector="TextBox.Valid">
            <Setter Property="Background" Value="DarkGreen" />
        </Style>

        <Style Selector="Button.SelectFile">
            <Setter Property="Content" Value="…" />
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="3 0 0 0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid Margin="5">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto"
                  Margin="0 0 0 5">
                <TextBox Grid.Column="0"
                         Classes.Invalid="{Binding !IsSteamDirectoryValid}"
                         Classes.Valid="{Binding IsSteamDirectoryValid}"
                         Text="{Binding SteamDirectory}"
                         Watermark="Steam Directory" />
                <Button Grid.Column="1"
                        Classes="SelectFile"
                        Command="{Binding SelectSteamDirectory}" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="2 0">
                <TextBlock Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Text="{Binding WorkshopDirectoryMessage}"
                           IsVisible="{Binding IsShowWorkshopDirectoryMessage}" />
                <TextBlock Grid.Column="0"
                           Margin="0 0 2 0"
                           Text="{Binding Ets2ModsDirectoryMessage}"
                           IsVisible="{Binding !IsShowWorkshopDirectoryMessage}" />
                <TextBlock Grid.Column="1"
                           Margin="2 0 0 0"
                           Text="{Binding AtsModsDirectoryMessage}"
                           IsVisible="{Binding !IsShowWorkshopDirectoryMessage}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
