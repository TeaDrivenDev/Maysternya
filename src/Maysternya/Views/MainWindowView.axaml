<Window x:Class="TeaDriven.Maysternya.Views.MainWindowView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:domain="using:TeaDriven.Maysternya.Domain"
        xmlns:logging="using:TeaDriven.Maysternya"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mdi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:uiUtilities="using:TeaDriven.Maysternya.UIUtilities"
        xmlns:vm="using:TeaDriven.Maysternya.ViewModels"
        Title="{DynamicResource Loc.WindowTitle}"
        Width="1024"
        MinWidth="800"
        MinHeight="500"
        d:DesignHeight="450"
        d:DesignWidth="800"
        x:DataType="vm:MainWindowViewModel"
        Closing="Window_OnClosing"
        Design.DataContext="{Binding Source={x:Static vm:MainWindowViewModel.DesignVM}}"
        Icon="/Assets/avalonia-logo.ico"
        mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FileSelectionOk"
                                     Color="LimeGreen" />
                    <SolidColorBrush x:Key="FileSelectionError"
                                     Color="IndianRed" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="FileSelectionOk"
                                     Color="DarkGreen" />
                    <SolidColorBrush x:Key="FileSelectionError"
                                     Color="DarkRed" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBox.Valid">
            <Setter Property="Background" Value="{DynamicResource FileSelectionOk}" />
        </Style>
        <Style Selector="TextBox:not(.Valid)">
            <Setter Property="Background" Value="{DynamicResource FileSelectionError}" />
        </Style>

        <Style Selector="Button.SelectFile">
            <Setter Property="Content" Value="…" />
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="3 0 0 0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="DataGridRow DataGridCell">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Styles>

    <Grid Margin="5">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <Grid Grid.Row="0"
                  Margin="0 0 0 5"
                  ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0"
                         Classes.Valid="{Binding IsSteamDirectoryValid}"
                         Text="{Binding SteamDirectory}"
                         Watermark="{DynamicResource Loc.SteamDirectory}" />
                <Button Grid.Column="1"
                        Classes="SelectFile"
                        Command="{Binding SelectSteamDirectory}" />
                <mdi:MaterialIcon Grid.Column="2"
                                  Width="20"
                                  Height="20"
                                  Margin="7 0 0 0"
                                  Background="Transparent"
                                  Kind="QuestionMarkCircleOutline"
                                  ToolTip.Tip="{DynamicResource Loc.SteamDirectoryInfoMessage}" />
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0 0 0 5"
                  ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox Grid.Column="0"
                         Classes.Valid="{Binding IsHashFsExtractorPathValid}"
                         Text="{Binding HashFsExtractorPath}"
                         Watermark="{DynamicResource Loc.HashFsExtractor}" />
                <Button Grid.Column="1"
                        Classes="SelectFile"
                        Command="{Binding SelectHashFsExtractor}" />
                <HyperlinkButton Grid.Column="2"
                                 Content="{DynamicResource Loc.Download}"
                                 NavigateUri="https://github.com/sk-zk/Extractor/releases" />
                <mdi:MaterialIcon Grid.Column="3"
                                  Width="20"
                                  Height="20"
                                  Background="Transparent"
                                  Kind="QuestionMarkCircleOutline"
                                  ToolTip.Tip="{DynamicResource Loc.ExtractorInfoMessage}" />
            </Grid>

            <Grid Grid.Row="2"
                  Margin="2 5 2 0"
                  ColumnDefinitions="*,*,Auto">
                <TextBlock Grid.Column="0"
                           Grid.ColumnSpan="2"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsShowWorkshopDirectoryMessage}"
                           Text="{Binding WorkshopDirectoryMessage}" />

                <RadioButton Grid.Column="0"
                             Margin="0 0 2 0"
                             Content="{Binding Ets2ModsDirectoryMessage}"
                             GroupName="SelectedGame"
                             IsCheckedChanged="SelectedGame_OnIsCheckedChanged"
                             IsEnabled="{Binding IsEts2ModsDirectoryFound}"
                             IsVisible="{Binding !IsShowWorkshopDirectoryMessage}"
                             Tag="{x:Static domain:SelectedGame.Ets2}">
                    <RadioButton.IsChecked>
                        <MultiBinding Converter="{x:Static uiUtilities:ValuesEqualMultiConverter.Instance}">
                            <Binding Path="SelectedGame" />
                            <Binding Path="Tag"
                                     RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </RadioButton.IsChecked>
                </RadioButton>

                <RadioButton Grid.Column="1"
                             Margin="2 0 0 0"
                             Content="{Binding AtsModsDirectoryMessage}"
                             GroupName="SelectedGame"
                             IsCheckedChanged="SelectedGame_OnIsCheckedChanged"
                             IsEnabled="{Binding IsAtsModsDirectoryFound}"
                             IsVisible="{Binding !IsShowWorkshopDirectoryMessage}"
                             Tag="{x:Static domain:SelectedGame.Ats}">
                    <RadioButton.IsChecked>
                        <MultiBinding Converter="{x:Static uiUtilities:ValuesEqualMultiConverter.Instance}">
                            <Binding Path="SelectedGame" />
                            <Binding Path="Tag"
                                     RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </RadioButton.IsChecked>
                </RadioButton>

                <Button Grid.Column="2"
                        Command="{Binding RefreshModsList}"
                        Content="{mdi:MaterialIconExt Kind=Refresh}"
                        IsEnabled="{Binding SelectedGame,
                                            Converter={x:Static uiUtilities:ValueEqualsParameterConverter.IsNotEqual},
                                            ConverterParameter={x:Static domain:SelectedGame.NoGame}}"
                        ToolTip.Tip="{DynamicResource Loc.RefreshList}" />
            </Grid>

            <SplitView Grid.Row="3"
                       Margin="0 10 0 0"
                       CompactPaneLength="40"
                       DisplayMode="CompactInline"
                       IsPaneOpen="{Binding IsShowLog}"
                       OpenPaneLength="300"
                       PanePlacement="Bottom">
                <SplitView.Content>
                    <DataGrid CanUserResizeColumns="True"
                              IsEnabled="{Binding SelectedGame,
                                                  Converter={x:Static uiUtilities:ValueEqualsParameterConverter.IsNotEqual},
                                                  ConverterParameter={x:Static domain:SelectedGame.NoGame}}"
                              ItemsSource="{Binding Mods}"
                              SelectionMode="Single">

                        <!--  see https://github.com/AvaloniaUI/Avalonia/discussions/8854  -->
                        <DataGrid.Styles>
                            <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                                <Setter Property="IsVisible" Value="False" />
                            </Style>
                            <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
                                <Setter Property="IsVisible" Value="False" />
                            </Style>
                        </DataGrid.Styles>

                        <DataGrid.Columns>
                            <DataGridTextColumn Width="100"
                                                Binding="{Binding Id}"
                                                CanUserResize="False"
                                                Header="{DynamicResource Loc.Id}" />

                            <DataGridTemplateColumn Width="*"
                                                    CanUserResize="True"
                                                    CanUserSort="True"
                                                    Header="{DynamicResource Loc.Name}"
                                                    SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10 0"
                                              Background="Transparent"
                                              ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Margin="0 0 10 0"
                                                       VerticalAlignment="Center"
                                                       Classes.DescriptionDisplayName="{Binding DisplayNameSource,
                                                                                                Converter={x:Static uiUtilities:ValueEqualsParameterConverter.IsEqual},
                                                                                                ConverterParameter={x:Static domain:DisplayNameSource.DescriptionFile}}"
                                                       Classes.UnavailableDisplayName="{Binding DisplayNameSource,
                                                                                                Converter={x:Static uiUtilities:ValueEqualsParameterConverter.IsEqual},
                                                                                                ConverterParameter={x:Static domain:DisplayNameSource.Unavailable}}"
                                                       TextTrimming="{x:Static TextTrimming.CharacterEllipsis}">
                                                <TextBlock.Styles>
                                                    <Style Selector="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Name}" />
                                                    </Style>

                                                    <Style Selector="TextBlock.DescriptionDisplayName">
                                                        <Setter Property="Text" Value="{Binding Name, StringFormat=> {0}}" />
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                        <Setter Property="Foreground" Value="LightGray" />
                                                    </Style>

                                                    <Style Selector="TextBlock.UnavailableDisplayName">
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                        <Setter Property="Foreground" Value="LightSlateGray" />
                                                    </Style>
                                                </TextBlock.Styles>
                                            </TextBlock>

                                            <mdi:MaterialIcon Grid.Column="1"
                                                              Width="20"
                                                              Height="20"
                                                              Background="Transparent"
                                                              IsVisible="{Binding Description,
                                                                                  Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                              Kind="InformationOutline"
                                                              ToolTip.Tip="{Binding Description}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="150"
                                                    CanUserResize="True"
                                                    CanUserSort="True"
                                                    Header="{DynamicResource Loc.Author}"
                                                    SortMemberPath="Author">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="10 0"
                                              Background="Transparent"
                                              ToolTip.Tip="{Binding Author}">
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Author}"
                                                       TextTrimming="{x:Static TextTrimming.CharacterEllipsis}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Width="100"
                                                Binding="{Binding Version}"
                                                CanUserResize="False"
                                                CanUserSort="False"
                                                Header="{DynamicResource Loc.Version}" />

                            <DataGridTemplateColumn Width="115"
                                                    CanUserResize="False"
                                                    Header="{DynamicResource Loc.UsableWith}"
                                                    SortMemberPath="HighestCompatibleGameVersion">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Stretch"
                                              Classes.Allowed="{Binding VersionCompatibility,
                                                                        Converter={x:Static uiUtilities:ValueEqualsParameterConverter.IsEqual},
                                                                        ConverterParameter={x:Static domain:VersionCompatibility.Allowed}}"
                                              Classes.Incompatible="{Binding VersionCompatibility,
                                                                             Converter={x:Static uiUtilities:ValueEqualsParameterConverter.IsEqual},
                                                                             ConverterParameter={x:Static domain:VersionCompatibility.Incompatible}}"
                                              Classes.Unrestricted="{Binding VersionCompatibility,
                                                                             Converter={x:Static uiUtilities:ValueEqualsParameterConverter.IsEqual},
                                                                             ConverterParameter={x:Static domain:VersionCompatibility.Unrestricted}}">
                                            <Grid.Styles>
                                                <Style Selector="Grid.Allowed">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Opacity="0.7"
                                                                             Color="ForestGreen" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>

                                                <Style Selector="Grid.Incompatible">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Opacity="0.7"
                                                                             Color="DarkRed" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>

                                                <Style Selector="Grid.Unrestricted">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <SolidColorBrush Opacity="0.3"
                                                                             Color="ForestGreen" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Grid.Styles>

                                            <Grid Margin="10 0"
                                                  ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding HighestCompatibleGameVersion}" />
                                                <Button Grid.Column="1"
                                                        Margin="0 0 10 0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding RemoveVersionRestriction}"
                                                        Content="X"
                                                        ToolTip.Tip="{DynamicResource Loc.RemoveRestrictionButtonToolTip}">
                                                    <Button.IsVisible>
                                                        <Binding Converter="{x:Static uiUtilities:ValueEqualsParameterConverter.IsEqual}"
                                                                 Path="VersionCompatibility">
                                                            <Binding.ConverterParameter>
                                                                <uiUtilities:XamlValueCollection>
                                                                    <uiUtilities:XamlWrapper Item="{x:Static domain:VersionCompatibility.Incompatible}" />
                                                                    <uiUtilities:XamlWrapper Item="{x:Static domain:VersionCompatibility.Indeterminate}" />
                                                                </uiUtilities:XamlValueCollection>
                                                            </Binding.ConverterParameter>
                                                        </Binding>
                                                    </Button.IsVisible>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </SplitView.Content>

                <SplitView.Pane>
                    <Grid RowDefinitions="Auto,Auto,*">
                        <GridSplitter Grid.Row="0"
                                      IsEnabled="False" />

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsShowLog}"
                                    Orientation="Horizontal">
                            <TextBlock Margin="5 0 10 0"
                                       VerticalAlignment="Center"
                                       Text="{DynamicResource Loc.MinLogLevel}" />
                            <ComboBox Width="135"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      ItemsSource="{uiUtilities:UnionCaseItemsSource x:TypeArguments=logging:LogLevel}"
                                      SelectedValue="{Binding MinLogLevel}" />
                        </StackPanel>

                        <Button x:Name="ShowLogButton"
                                Grid.Row="1"
                                Margin="3"
                                HorizontalAlignment="Right"
                                Classes.IsShowLog="{Binding IsShowLog}"
                                Command="{Binding ToggleIsShowLog}">
                            <Button.Styles>
                                <Style Selector="Button.IsShowLog">
                                    <Setter Property="Content" Value="{DynamicResource Loc.HideLog}" />
                                </Style>

                                <Style Selector="Button:not(.IsShowLog)">
                                    <Setter Property="Content" Value="{DynamicResource Loc.ShowLog}" />
                                </Style>
                            </Button.Styles>
                        </Button>

                        <DataGrid Grid.Row="2"
                                  IsVisible="{Binding IsShowLog}"
                                  ItemsSource="{Binding LogEntries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Timestamp,
                                                                      StringFormat=s}"
                                                    Header="{DynamicResource Loc.Time}" />
                                <DataGridTextColumn Binding="{Binding LogLevel}"
                                                    Header="{DynamicResource Loc.LogLevel}" />
                                <DataGridTextColumn Binding="{Binding Activity}"
                                                    Header="{DynamicResource Loc.Activity}" />
                                <DataGridTextColumn Binding="{Binding Message}"
                                                    Header="{DynamicResource Loc.Message}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </SplitView.Pane>
            </SplitView>
        </Grid>
    </Grid>
</Window>
